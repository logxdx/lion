{
  "listen": "127.0.0.1:11434",
  "idle_unload_s": 600,
  "start_timeout_s": 300,
  "default_model": "lfm3",
  "ui_dir": "build/webui",
  "tools_dir": ["tools/webtools", "../liquid-engine/tools/webtools"],
  "node": "node",
  "tool_timeout_s": 300,
  "state_dir": "~/.cache/hop",
  "backends": [
    {
      "name": "liquid-engine",
      "command": ["~/liquine/serve.sh", "--no-ui", "--no-tools"],
      "env": {"PORT": "11500"},
      "port": 11500,
      "routes": ["/v1/systemone"],
      "models": [
        {"id": "lfm3", "n_ctx": 131072, "slots": 4},
        {"id": "lfm3-vl", "n_ctx": 128000, "slots": 4, "vision": true, "video": true},
        {"id": "d1", "chat": false}
      ]
    },
    {
      "name": "raon-engine",
      "command": ["~/raon/serve.sh", "--no-ui", "--no-tools"],
      "env": {"PORT": "11501"},
      "port": 11501,
      "models": [
        {"id": "raon-1-nano", "n_ctx": 131072, "slots": 4}
      ]
    }
  ]
}
